From 84b48207e0feae46d34c8dc9982518875de06682 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Matti=20Lehtim=C3=A4ki?= <matti.lehtimaki@jolla.com>
Date: Thu, 10 Jun 2021 19:35:16 +0300
Subject: [PATCH] Disable Erlang checks.

Not needed and requirement not available.
---
 pyproject.toml              | 1 -
 rpmlint/configdefaults.toml | 1 -
 test/test_lint.py           | 1 -
 3 files changed, 3 deletions(-)

diff --git a/pyproject.toml b/pyproject.toml
index 8fbd3b0f..91f07a66 100644
--- a/pyproject.toml
+++ b/pyproject.toml
@@ -35,7 +35,6 @@ classifiers = [
 ]
 keywords = ["RPM", ".spec", "validator"]
 dependencies = [
-    "pybeam",
     "pyxdg",
     "rpm",
     "tomli;python_version<'3.11'",
diff --git a/rpmlint/configdefaults.toml b/rpmlint/configdefaults.toml
index a24295da..02abc2ad 100644
--- a/rpmlint/configdefaults.toml
+++ b/rpmlint/configdefaults.toml
@@ -8,7 +8,6 @@ Checks = [
     "DBusPolicyCheck",
     'DuplicatesCheck',
     "DocCheck",
-    "ErlangCheck",
     "FHSCheck",
     "FilesCheck",
     "IconSizesCheck",
diff --git a/test/test_lint.py b/test/test_lint.py
index 202245cd..21bcca43 100644
--- a/test/test_lint.py
+++ b/test/test_lint.py
@@ -36,7 +36,6 @@ basic_tests = [
     'DBusPolicyCheck',
     'DuplicatesCheck',
     'DocCheck',
-    'ErlangCheck',
     'FHSCheck',
     'FilesCheck',
     'IconSizesCheck',
